# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# FIREBASE_PROJECT_ID: Cloudflare Worker environment variable for verifying Firebase ID Tokens.
FIREBASE_PROJECT_ID=

# ADMIN_BOOTSTRAP_TOKEN: Secret token required for temporary initial ADMIN creation (POST /api/v1/admin/bootstrap)
ADMIN_BOOTSTRAP_TOKEN=
